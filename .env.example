MONDAY_API_KEY=your_monday_api_token
MONDAY_CLIENT_MASTER_BOARD_ID=your_client_master_board_id
MONDAY_TEMPLATE_BOARD_ID=your_template_board_id
MONDAY_EXECUTION_BOARD_ID=your_execution_board_id
MONDAY_QUESTIONNAIRE_TEMPLATE_BOARD_ID=your_questionnaire_template_board_id
MONDAY_QUESTIONNAIRE_EXECUTION_BOARD_ID=your_questionnaire_execution_board_id
RENDER_URL=https://tdot-automations.onrender.com
PORT=5050

# ─── Phase 2 — New Leads board (Lead Board) ──────────────────────────
MONDAY_LEAD_BOARD_ID=
MONDAY_LEAD_TOKEN_COL_ID=

# ─── Phase 2 — Square ────────────────────────────────────────────────
SQUARE_ACCESS_TOKEN=
SQUARE_WEBHOOK_SECRET=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox

# ─── Phase 2 — Adobe Sign (OAuth 2.0) ────────────────────────────────
ADOBESIGN_CLIENT_ID=
ADOBESIGN_CLIENT_SECRET=
ADOBESIGN_RETAINER_TEMPLATE_ID=

# ─── Phase 2 — Zoom (server-to-server OAuth) ─────────────────────────
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

# ─── Phase 2 — Anthropic ─────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Questionnaire progress → Monday ─────────────────────────────────
# Every client save syncs "Q Readiness" % + "Q Completion Status" to the
# Client Master row (the % is derived server-side from every member's saved
# file). Autosaves are coalesced to one write per case per this window (ms).
# Default 300000 (5 min); 0 = every save.
Q_PROGRESS_SYNC_MS=
# A manual "Save Progress" is debounced by this many ms so a family case's
# burst of member saves becomes one write. Default 1500; 0 = write at once.
Q_PROGRESS_MANUAL_DEBOUNCE_MS=
